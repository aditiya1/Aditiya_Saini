    .modal-footer { display: flex; justify-content: flex-end; gap: 0.5rem; padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0; }
    .btn-close { background: none; border: none; font-size: 1.25rem; cursor: pointer; opacity: 0.5; }
    .btn-close:hover { opacity: 1; }
</style>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private Project? project;
    private List<TaskItem> tasks = [];
    private bool loading = true;
    private string? error;
    private string searchTerm = "";
    private string priorityFilter = "";
    private bool showModal;
    private TaskItem? editingTask;
    private TaskFormModel formModel = new();
    private CancellationTokenSource? _searchCts;
    private TaskStatus? _dragOverColumn;
    private DotNetObjectReference<ProjectTasks>? _dotNetRef;
    private bool _dragDropInitialized;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectAndTasks();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (project?.Id != ProjectId)
            await LoadProjectAndTasks();
    }

    private async Task LoadProjectAndTasks()
    {
        loading = true;
        error = null;
        StateHasChanged();
        try
        {
            project = await ProjectApi.GetProjectAsync(ProjectId);
            if (project != null)
                await LoadTasks();
        }
        catch { project = null; }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dragDropInitialized && tasks.Any())
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initKanbanDragDrop", _dotNetRef);
            _dragDropInitialized = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragDropInitialized)
            await JS.InvokeVoidAsync("disposeKanbanDragDrop");
        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public async Task OnTaskDropped(int taskId, int targetStatus)
    {
        var task = tasks.FirstOrDefault(t => t.Id == taskId);
        if (task == null || task.Status == (TaskStatus)targetStatus) { _dragOverColumn = null; StateHasChanged(); return; }

        try
        {
            await TaskApi.UpdateStatusAsync(task.Id, (TaskStatus)targetStatus);
            task.Status = (TaskStatus)targetStatus;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        _dragOverColumn = null;
        StateHasChanged();
    }

    private async Task LoadTasks()
    {
        try
        {
            var priority = string.IsNullOrEmpty(priorityFilter) ? null : (TaskPriority?)int.Parse(priorityFilter);
            tasks = await TaskApi.GetTasksAsync(ProjectId, null, priority, string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm);
        }
        catch (Exception ex)
        {
            if (!TaskApi.IsUsingFallback)
                error = $"Failed to load tasks. Error: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task OnSearchInput()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, _searchCts.Token);
            await LoadTasks();
        }
        catch (OperationCanceledException) { }
    }

    private List<TaskItem> GetTasksForStatus(TaskStatus status) =>
        tasks.Where(t => t.Status == status).OrderByDescending(t => t.CreatedAt).ToList();

    private static string GetStatusLabel(TaskStatus s) => s switch
    {
        TaskStatus.ToDo => "To Do",
        TaskStatus.InProgress => "In Progress",
        TaskStatus.Done => "Done",
        TaskStatus.Cancelled => "Cancelled",
        _ => s.ToString()
    };

    private static string GetColumnHeaderClass(TaskStatus s) => s.ToString().ToLowerInvariant().Replace(" ", "");

    private void OpenCreateModal()
    {
        editingTask = null;
        formModel = new TaskFormModel
        {
            Title = "",
            Description = "",
            Priority = TaskPriority.Medium,
            Status = TaskStatus.ToDo,
            Assignee = "",
            Subtasks = [],
            Remarks = []
        };
        showModal = true;
    }

    private void OpenEditModal(TaskItem task)
    {
        editingTask = task;
        formModel = new TaskFormModel
        {
            Title = task.Title,
            Description = task.Description ?? "",
            Priority = task.Priority,
            Status = task.Status,
            DueDate = task.DueDate,
            Assignee = task.Assignee ?? "",
            Subtasks = task.GetSubtasks().Select(s => new SubtaskItem { Title = s.Title, Completed = s.Completed }).ToList(),
            Remarks = task.GetRemarks().Select(r => new RemarkItem { Text = r.Text, Date = r.Date }).ToList()
        };
        showModal = true;
    }

    private void AddSubtask() { formModel.Subtasks.Add(new SubtaskItem { Title = "", Completed = false }); }
    private void RemoveSubtask(int i) { formModel.Subtasks.RemoveAt(i); }
    private void ToggleSubtask(int i) { formModel.Subtasks[i].Completed = !formModel.Subtasks[i].Completed; }
    private void AddRemark() { formModel.Remarks.Add(new RemarkItem { Text = "", Date = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ") }); }
    private void RemoveRemark(int i) { formModel.Remarks.RemoveAt(i); }

    private void CloseModal()
    {
        showModal = false;
        editingTask = null;
    }

    private async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title) || project == null) return;

        try
        {
            var subtasks = formModel.Subtasks.Where(s => !string.IsNullOrWhiteSpace(s.Title)).ToList();
            var remarks = formModel.Remarks.Where(r => !string.IsNullOrWhiteSpace(r.Text)).Select(r => new RemarkItem { Text = r.Text, Date = r.Date }).ToList();

            if (editingTask?.Id != null)
            {
                await TaskApi.UpdateTaskAsync(editingTask.Id, new UpdateTaskRequest(
                    formModel.Title, formModel.Description, formModel.Priority, formModel.Status, formModel.DueDate,
                    string.IsNullOrWhiteSpace(formModel.Assignee) ? null : formModel.Assignee, subtasks, remarks));
            }
            else
            {
                await TaskApi.CreateTaskAsync(new CreateTaskRequest(
                    ProjectId, formModel.Title, formModel.Description, formModel.Priority, formModel.Status, formModel.DueDate,
                    string.IsNullOrWhiteSpace(formModel.Assignee) ? null : formModel.Assignee, subtasks, remarks));
            }
            CloseModal();
            await LoadTasks();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteTask(TaskItem task)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{task.Title}\"?")) return;

        try
        {
            await TaskApi.DeleteTaskAsync(task.Id);
            await LoadTasks();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static string GetPriorityClass(TaskPriority p) => p.ToString();

    private class TaskFormModel
    {
        [Required(ErrorMessage = "Title is required")]
        [MaxLength(200)]
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public TaskPriority Priority { get; set; } = TaskPriority.Medium;
        public TaskStatus Status { get; set; } = TaskStatus.ToDo;
        public DateTime? DueDate { get; set; }
        public string Assignee { get; set; } = "";
        public List<SubtaskItem> Subtasks { get; set; } = [];
        public List<RemarkItem> Remarks { get; set; } = [];
    }
}
