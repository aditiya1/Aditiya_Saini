    .modal-content { background: #fff; border-radius: 12px; max-width: 500px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
    .modal-content-wide { max-width: 560px; max-height: 90vh; overflow-y: auto; }
