    .back-link:hover { color: #0f172a; }
    .kanban-header { margin-bottom: 1.5rem; }
    .project-badge { display: inline-block; padding: 0.4rem 1rem; border-radius: 8px; font-weight: 600; font-size: 1.25rem; margin-bottom: 0.75rem; }
    .kanban-header-main { display: flex; flex-direction: column; gap: 1rem; }
    .kanban-header-actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .search-box { display: flex; align-items: center; gap: 0.5rem; background: #fff; border-radius: 8px; padding: 0.5rem 0.75rem; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .search-box .bi { color: #94a3b8; }
    .search-box input { border: none; outline: none; width: 200px; font-size: 0.9rem; }
